  "dependencies": {
    "react":       "^18.3.1",
    "react-dom":   "^18.3.1",
    "zustand":     "^4.5.4",
    "jspdf":       "^2.5.1",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/react":                        "^18.3.3",
    "@types/react-dom":                    "^18.3.0",
    "@vitejs/plugin-react":                "^4.3.1",
    "typescript":                          "^5.5.3",
    "vite":                                "^5.4.1",
    "vitest":                              "^2.0.5",
    "@vitest/ui":                          "^2.0.5",
    "@testing-library/react":             "^16.0.0",
    "@testing-library/jest-dom":          "^6.4.8",
    "jsdom":                               "^24.1.1",
    "eslint":                              "^8.57.0",
    "@typescript-eslint/parser":           "^7.18.0",
    "@typescript-eslint/eslint-plugin":    "^7.18.0"
  }
